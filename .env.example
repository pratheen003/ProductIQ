# ProductIQ Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM Configuration ---
# Required for Phase 0 connectivity test and Phase 4+ enrichment.
LLM_API_KEY=

# Optional: override the default model (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Optional: request timeout in seconds (default: 30)
# LLM_TIMEOUT_SECONDS=30

# --- Application Configuration ---
# Optional: override the data directory path
# DATA_DIR=./data

# Optional: log level (DEBUG, INFO, WARNING, ERROR) — default: INFO
# LOG_LEVEL=INFO
