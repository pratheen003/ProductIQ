# ProductIQ Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM Provider Configuration ---
# Active provider: "groq" (default) or "openai"
LLM_PROVIDER=groq

# Groq API Key (Primary hackathon provider)
GROQ_API_KEY=

# OpenAI API Key (Optional / fallback provider)
OPENAI_API_KEY=

# Generic key fallback (supported for backwards compatibility)
LLM_API_KEY=

# Optional: override the default model
# For Groq: openai/gpt-oss-20b (default), openai/gpt-oss-120b, llama-3.3-70b-versatile
# For OpenAI: gpt-4o-mini (default), gpt-4o
# LLM_MODEL=openai/gpt-oss-20b

# Optional: request timeout in seconds (default: 30)
# LLM_TIMEOUT_SECONDS=30

# --- Application Configuration ---
# Optional: override the data directory path
# DATA_DIR=./data

# Optional: log level (DEBUG, INFO, WARNING, ERROR) — default: INFO
# LOG_LEVEL=INFO
